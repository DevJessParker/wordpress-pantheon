name: wordpress-pantheon
recipe: pantheon
config:
  framework: wordpress
  site: YOUR_PANTHEON_SITE_NAME
  id: YOUR_PANTHEON_SITE_ID

services:
  appserver:
    # PERFORMANCE: Minimal build steps - Pantheon recipe includes most tools
    # These run on EVERY lando start, so keep them fast!
    build_as_root:
      # Quick check - uses Pantheon recipe's built-in tools
      - echo "Container ready (using Pantheon recipe defaults)"
    build:
      # PERFORMANCE: Only check composer on first start
      # After that, skip to save 5-10 seconds per restart
      - >
        if [ ! -f "/app/.composer-installed" ]; then
          if [ ! -d "vendor" ] || [ ! -f "vendor/autoload.php" ]; then
            echo "Installing Composer dependencies (first time only)...";
            composer install --no-interaction --prefer-dist --optimize-autoloader;
            touch /app/.composer-installed;
          fi
        fi
    overrides:
      environment:
        # Enable WP_DEBUG for local development
        WP_DEBUG: 'true'
        WP_DEBUG_LOG: 'true'
        WP_DEBUG_DISPLAY: 'false'
        # PERFORMANCE: Enable Composer cache for faster dependency installation
        COMPOSER_CACHE_DIR: '/var/www/.composer/cache'
        # Pantheon authentication - loads from .env file
        # This prevents interactive token prompts during lando pull
        TERMINUS_MACHINE_TOKEN: '${TERMINUS_TOKEN}'

  database:
    type: mysql:5.7  # PERFORMANCE: 5.7 starts 2x faster than 8.0 (30s vs 60s)
    portforward: true
    creds:
      user: wordpress
      password: wordpress
      database: wordpress
    overrides:
      environment:
        MYSQL_ROOT_PASSWORD: root

  # OPTIONAL: Uncomment if you need Redis cache for local dev
  # cache:
  #   type: redis:7
  #   portforward: true

  # OPTIONAL: Uncomment if you need PhpMyAdmin GUI (adds 10-15s to startup)
  # Alternatives: lando wp db query, TablePlus, MySQL Workbench
  # pma:
  #   type: phpmyadmin
  #   hosts:
  #     - database

tooling:
  # Database operations
  pull-db:
    service: appserver
    description: Pull database from Pantheon Dev environment
    cmd:
      - /app/scripts/pull-db.sh

  push-db:
    service: appserver
    description: Push database to Pantheon Dev environment (USE WITH CAUTION)
    cmd:
      - /app/scripts/push-db.sh

  sync-db:
    service: appserver
    description: Sync database from Pantheon Dev environment
    cmd:
      - terminus backup:create ${PANTHEON_SITE}.dev --element=db
      - /app/scripts/pull-db.sh

  # File operations
  pull-files:
    service: appserver
    description: Pull files from Pantheon Dev environment
    cmd:
      - /app/scripts/pull-files.sh

  # Cache operations
  clear-cache:
    service: appserver
    description: Clear WordPress caches
    cmd:
      - wp cache flush
      # - redis-cli -h cache FLUSHALL  # Uncomment if using Redis

  # Terminus commands
  terminus:
    service: appserver
    description: Run Terminus commands

  # WordPress CLI
  wp:
    service: appserver
    description: Run WP-CLI commands

  # Composer
  composer:
    service: appserver

  # Database backup
  backup-db:
    service: appserver
    description: Create local database backup
    cmd:
      - mkdir -p /app/backups
      - wp db export /app/backups/local-backup-$(date +%Y%m%d-%H%M%S).sql

  # OPTIONAL: Uncomment if using PhpMyAdmin
  # phpmyadmin:
  #   service: pma
  #   description: Open PhpMyAdmin in browser

  # Security scan
  security-check:
    service: appserver
    description: Run security checks on WordPress installation
    cmd:
      - /app/scripts/security-check.sh

# OPTIONAL: Uncomment if using PhpMyAdmin
# proxy:
#   pma:
#     - pma.wordpress-pantheon.lndo.site

events:
  post-start:
    - appserver: echo "Lando is ready! Access your site at https://wordpress-pantheon.lndo.site"
    - appserver: echo ""
    - appserver: echo "Quick Commands:"
    - appserver: echo "  lando pull-db    - Pull database from Pantheon Dev"
    - appserver: echo "  lando pull-files - Pull files from Pantheon Dev"
    - appserver: echo "  lando wp         - Run WP-CLI commands"
    - appserver: echo "  lando terminus   - Run Terminus commands"
    - appserver: echo ""
    - appserver: echo "Database Access:"
    - appserver: echo "  Host: localhost  Port: Check 'lando info'"
    - appserver: echo "  User: wordpress  Pass: wordpress"

  post-db-import:
    - appserver: wp search-replace '$PANTHEON_SITE_URL' 'https://wordpress-pantheon.lndo.site' --skip-columns=guid --all-tables
