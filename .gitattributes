# Set default behavior to automatically normalize line endings
* text=auto

# Force shell scripts to always use LF line endings (Unix style)
*.sh text eol=lf

# Force bash scripts to use LF
*.bash text eol=lf

# Explicitly declare text files you want to always be normalized and converted to native line endings on checkout
*.php text
*.js text
*.css text
*.json text
*.yml text
*.yaml text
*.xml text
*.md text
*.txt text

# Denote binary files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.mov binary
*.mp4 binary
*.mp3 binary
*.zip binary
*.gz binary
*.tar binary
